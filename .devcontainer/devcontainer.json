{
  "name": "Routeflex",
  "workspaceFolder": "/workspaces/Routeflex",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3"
      }
    }
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "RouteFlex Preview",
      "onAutoForward": "openBrowser",
      "protocol": "http",
      "visibility": "public"
    }
  }
}
